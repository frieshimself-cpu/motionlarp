# The installer (deploy/install.sh) writes this file for you. By hand: copy to .env and fill in the first three.

# ── required ─────────────────────────────────────────────
# The domain your friends open (point its DNS A record at the server first)
DOMAIN=
# Opens the owner page at /admin: license keys, users, settings. 10+ characters.
ADMIN_PASSWORD=
# Encrypts every imported wallet key and stored secret. 64 hex chars: `openssl rand -hex 32`.
# Back it up: lose it and the stored keys are unreadable.
MASTER_KEY=

# ── the two connections: set HERE, once (deploy/set-keys.sh writes them for you). The website cannot change them. ──
# Helius → RPC → "RPC URL", e.g. https://mainnet.helius-rpc.com/?api-key=…
RPC_URL=
# The API key from portal.jup.ag (with a key, Jupiter's keyed address is used by itself)
JUPITER_API_KEY=

# ── set these on the admin page instead (values there override this file) ──
# Platform fee and its wallet, max SOL per buy, live trading.
LIVE_TRADING=false
MAX_SOL_PER_BUY=30
FEE_BPS=0
FEE_WALLET=
# Usernames that pay no platform fee, comma-separated (a license key can also carry a 0 % fee)
FEE_EXEMPT_USERS=

# ── server ──────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
# true behind HTTPS (docker-compose sets it)
SECURE_COOKIES=false
DB_PATH=./data/motionlarp.db
LOG_LEVEL=info
# SOL kept back in a wallet for fees; a live buy that would leave less is skipped
FEE_RESERVE_SOL=0.01
BRAND_NAME=WalletMotion
