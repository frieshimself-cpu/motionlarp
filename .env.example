# ── required ─────────────────────────────────────────────
# A paid Solana RPC (Helius, QuickNode, Triton…). The public one rate-limits too hard for copying.
RPC_URL=
# Optional: websocket URL if your provider's differs from RPC_URL with https→wss
RPC_WS_URL=
# Encrypts every imported wallet key. 64 hex chars: run `npm run genkey`. Back it up: lose it and keys are unreadable.
MASTER_KEY=
# Friends need this code to sign up (leave empty = anyone with the link can sign up)
SIGNUP_CODE=

# ── safety ──────────────────────────────────────────────
# false = test mode for everyone (simulated, nothing sent). true = copies set to Live really trade.
LIVE_TRADING=false
# No single copy buy may exceed this (SOL)
MAX_SOL_PER_BUY=0.05
# SOL kept back in a wallet for fees; a live buy that would leave less is skipped
FEE_RESERVE_SOL=0.01

# ── server ──────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
# true behind HTTPS (production)
SECURE_COOKIES=false
DB_PATH=./data/motionlarp.db
LOG_LEVEL=info

# ── docker-compose only ─────────────────────────────────
# The domain your friends open (point its DNS A record at the server first)
DOMAIN=

# ── platform fee (your cut) ─────────────────────────────
# A share of every copy buy and sell, sent to FEE_WALLET inside the same transaction (no trade, no fee).
# 100 = 1 %. 0 = off. Capped at 1000 (10 %). Users see the fee on the site.
FEE_BPS=0
FEE_WALLET=
# Usernames that pay no fee, comma-separated (e.g. your own)
FEE_EXEMPT_USERS=

# ── any coin, any launchpad ─────────────────────────────
# pump.fun / PumpSwap coins use the fast native route; everything else is routed through Jupiter.
# The free endpoint works but is rate-limited; for more traffic get a key at portal.jup.ag and use:
#   JUPITER_URL=https://api.jup.ag   JUPITER_API_KEY=your-key
JUPITER_URL=https://lite-api.jup.ag
JUPITER_API_KEY=
