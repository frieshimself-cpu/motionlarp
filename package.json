{
  "name": "motionlarp",
  "version": "0.1.0",
  "private": true,
  "description": "Copytrade website: import a wallet, pick wallets to copy, custom buy size and sell rules (pump.fun + PumpSwap).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:mainnet": "tsx --disable-warning=ExperimentalWarning scripts/check-mainnet.ts",
    "check:exactbuy": "tsx --disable-warning=ExperimentalWarning scripts/check-exact-buy.ts",
    "measure": "tsx --disable-warning=ExperimentalWarning scripts/measure-latency.ts",
    "fixture": "tsx --disable-warning=ExperimentalWarning scripts/fetch-fixture.ts",
    "genkey": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "^4.0.0",
    "@pump-fun/pump-swap-sdk": "^2.1.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
