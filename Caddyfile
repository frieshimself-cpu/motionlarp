{$DOMAIN} {
	encode gzip
	reverse_proxy app:3000
}

# www.<domain> forwards to the main address. Needs a DNS record for www (a CNAME to the domain); without one,
# Caddy just logs that it could not get a certificate for www, and the main site is unaffected.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
